[
  { "id": "tab1", "type": "tab", "label": "Air quality", "disabled": false, "info": "" },
  {
    "id": "broker", "type": "mqtt-broker", "name": "HiveMQ public", "broker": "broker.hivemq.com", "port": "1883",
    "clientid": "", "autoConnect": true, "usetls": false, "protocolVersion": "4", "keepalive": "60",
    "cleansession": true
  },
  {
    "id": "uibase", "type": "ui-base", "name": "Air quality", "path": "/dashboard", "includeClientData": true,
    "acceptsClientConfig": ["ui-notification", "ui-control"], "showPathInSidebar": false,
    "navigationStyle": "none", "titleBarStyle": "default"
  },
  {
    "id": "uitheme", "type": "ui-theme", "name": "Default",
    "colors": { "surface": "#ffffff", "primary": "#0094ce", "bgPage": "#eeeeee", "groupBg": "#ffffff", "groupOutline": "#cccccc" },
    "sizes": { "density": "default", "pagePadding": "12px", "groupGap": "12px", "groupBorderRadius": "4px", "widgetGap": "12px" }
  },
  {
    "id": "uipage", "type": "ui-page", "name": "Monitor", "ui": "uibase", "path": "/", "icon": "home", "layout": "grid",
    "theme": "uitheme", "order": 1, "className": "", "visible": "true", "disabled": "false",
    "breakpoints": [
      { "name": "Default", "px": "0", "cols": "3" },
      { "name": "Tablet", "px": "576", "cols": "6" },
      { "name": "Small Desktop", "px": "768", "cols": "9" },
      { "name": "Desktop", "px": "1024", "cols": "12" }
    ]
  },
  {
    "id": "grpnow", "type": "ui-group", "name": "Now", "page": "uipage", "width": "12", "height": "1", "order": 1,
    "showTitle": true, "className": "", "visible": "true", "disabled": "false", "groupType": "default"
  },
  {
    "id": "grptrend", "type": "ui-group", "name": "Trend", "page": "uipage", "width": "12", "height": "1", "order": 2,
    "showTitle": true, "className": "", "visible": "true", "disabled": "false", "groupType": "default"
  },
  {
    "id": "mqttin", "type": "mqtt in", "z": "tab1", "name": "telemetry", "topic": "ispu-node-4fe22d46/telemetry", "qos": "0",
    "datatype": "json", "broker": "broker", "nl": false, "rap": true, "rh": 0, "inputs": 0, "x": 130, "y": 160,
    "wires": [["split"]]
  },
  {
    "id": "split", "type": "function", "z": "tab1", "name": "split fields", "outputs": 7, "noerr": 0,
    "func": "const d = msg.payload;\nconst names = {BAIK: 'Baik', SEDANG: 'Sedang', TIDAK_SEHAT: 'Tidak sehat', BERBAHAYA: 'Berbahaya'};\nconst status = (names[d.status] || d.status) + (d.muted ? ' (alarm muted)' : '');\nconst forecast = names[d.forecast_3h] || d.forecast_3h || '-';\nreturn [\n  { payload: d.pm25_ugm3 },\n  { payload: d.gas_ppm },\n  [{ topic: 'PM2.5', payload: d.pm25_ugm3 }, { topic: 'Gas ppm', payload: d.gas_ppm }],\n  { payload: d.temp_c },\n  { payload: d.humidity_pct },\n  { payload: status },\n  { payload: forecast }\n];",
    "x": 330, "y": 160,
    "wires": [["gpm"], ["ggas"], ["chart"], ["gtemp"], ["ghum"], ["status"], ["forecast"]]
  },
  {
    "id": "gpm", "type": "ui-gauge", "z": "tab1", "group": "grpnow", "name": "PM2.5", "order": 1, "width": "3", "height": "3",
    "gtype": "gauge-half", "gstyle": "needle", "title": "PM2.5", "units": "ug/m3", "icon": "", "prefix": "", "suffix": "",
    "segments": [
      { "from": "0", "color": "#5cd65c" }, { "from": "15.5", "color": "#ffc107" },
      { "from": "55.4", "color": "#ff7043" }, { "from": "150.4", "color": "#e53935" }
    ],
    "min": 0, "max": 300, "sizeThickness": 16, "sizeGap": 4, "sizeKeyThickness": 8, "styleRounded": true, "styleGlow": false,
    "className": "", "x": 560, "y": 60, "wires": []
  },
  {
    "id": "ggas", "type": "ui-gauge", "z": "tab1", "group": "grpnow", "name": "Gas", "order": 2, "width": "3", "height": "3",
    "gtype": "gauge-half", "gstyle": "needle", "title": "Gas (CO/VOC)", "units": "ppm", "icon": "", "prefix": "", "suffix": "",
    "segments": [
      { "from": "0", "color": "#5cd65c" }, { "from": "200", "color": "#ffc107" },
      { "from": "400", "color": "#ff7043" }, { "from": "800", "color": "#e53935" }
    ],
    "min": 0, "max": 1000, "sizeThickness": 16, "sizeGap": 4, "sizeKeyThickness": 8, "styleRounded": true, "styleGlow": false,
    "className": "", "x": 560, "y": 100, "wires": []
  },
  {
    "id": "gtemp", "type": "ui-gauge", "z": "tab1", "group": "grpnow", "name": "Temperature", "order": 3, "width": "3", "height": "3",
    "gtype": "gauge-half", "gstyle": "needle", "title": "Temperature", "units": "C", "icon": "", "prefix": "", "suffix": "",
    "segments": [{ "from": "0", "color": "#0094ce" }, { "from": "34", "color": "#ff7043" }],
    "min": 0, "max": 50, "sizeThickness": 16, "sizeGap": 4, "sizeKeyThickness": 8, "styleRounded": true, "styleGlow": false,
    "className": "", "x": 570, "y": 220, "wires": []
  },
  {
    "id": "ghum", "type": "ui-gauge", "z": "tab1", "group": "grpnow", "name": "Humidity", "order": 4, "width": "3", "height": "3",
    "gtype": "gauge-half", "gstyle": "needle", "title": "Humidity", "units": "%", "icon": "", "prefix": "", "suffix": "",
    "segments": [{ "from": "0", "color": "#0094ce" }, { "from": "85", "color": "#ff7043" }],
    "min": 0, "max": 100, "sizeThickness": 16, "sizeGap": 4, "sizeKeyThickness": 8, "styleRounded": true, "styleGlow": false,
    "className": "", "x": 560, "y": 260, "wires": []
  },
  {
    "id": "forecast", "type": "ui-text", "z": "tab1", "group": "grpnow", "name": "AI forecast", "order": 6, "width": "6", "height": "1",
    "label": "AI forecast in 3 hours", "format": "{{msg.payload}}", "layout": "row-spread", "style": true, "font": "",
    "fontSize": "20", "color": "#b45309", "wrapText": false, "className": "", "value": "payload", "valueType": "msg",
    "x": 560, "y": 340, "wires": []
  },
  {
    "id": "status", "type": "ui-text", "z": "tab1", "group": "grpnow", "name": "Air status", "order": 5, "width": "6", "height": "1",
    "label": "Air quality now (ISPU)", "format": "{{msg.payload}}", "layout": "row-spread", "style": true, "font": "",
    "fontSize": "20", "color": "#0094ce", "wrapText": false, "className": "", "value": "payload", "valueType": "msg",
    "x": 560, "y": 300, "wires": []
  },
  {
    "id": "chart", "type": "ui-chart", "z": "tab1", "group": "grptrend", "name": "Trend", "label": "PM2.5 and gas", "order": 1,
    "width": "12", "height": "5", "chartType": "line", "category": "topic", "categoryType": "msg",
    "xAxisLabel": "", "xAxisProperty": "", "xAxisPropertyType": "msg", "xAxisType": "time", "xAxisFormat": "", "xAxisFormatType": "auto",
    "yAxisLabel": "", "yAxisProperty": "payload", "yAxisPropertyType": "msg", "ymin": "", "ymax": "",
    "action": "append", "stackSeries": false, "pointShape": "circle", "pointRadius": 2, "showLegend": true,
    "removeOlder": "10", "removeOlderUnit": "60", "removeOlderPoints": "", "colors": ["#0095ff", "#ff7f0e", "#2ca02c"],
    "textColor": ["#666666"], "textColorDefault": true, "gridColor": ["#e5e5e5"], "gridColorDefault": true,
    "interpolation": "linear", "className": "", "x": 560, "y": 140, "wires": [[]]
  },
  {
    "id": "mute", "type": "ui-switch", "z": "tab1", "group": "grpnow", "name": "Mute alarm", "label": "Mute alarm", "order": 7,
    "width": "3", "height": "1", "passthru": false, "decouple": false, "topic": "topic", "topicType": "msg", "style": "",
    "className": "", "evaluate": "true", "onvalue": "true", "onvalueType": "bool", "onicon": "", "oncolor": "",
    "offvalue": "false", "offvalueType": "bool", "officon": "", "offcolor": "", "x": 130, "y": 360, "wires": [["tocmd"]]
  },
  {
    "id": "tocmd", "type": "function", "z": "tab1", "name": "to command", "outputs": 1, "noerr": 0,
    "func": "msg.payload = msg.payload ? 'mute' : 'unmute';\nreturn msg;",
    "x": 320, "y": 360, "wires": [["mqttout"]]
  },
  {
    "id": "mqttout", "type": "mqtt out", "z": "tab1", "name": "command", "topic": "ispu-node-4fe22d46/command", "qos": "0",
